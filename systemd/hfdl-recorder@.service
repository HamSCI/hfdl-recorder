[Unit]
Description=hfdl-recorder HFDL recorder for %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
User=hfdlrec
Group=hfdlrec

WatchdogSec=120
NotifyAccess=main

EnvironmentFile=-/etc/sigmond/coordination.env
EnvironmentFile=-/etc/hfdl-recorder/env/%i.env

WorkingDirectory=/opt/git/sigmond/hfdl-recorder

ExecStartPre=+/bin/mkdir -p /var/lib/hfdl-recorder/%i
ExecStartPre=+/bin/mkdir -p /var/log/hfdl-recorder
ExecStartPre=+/usr/bin/chown -R hfdlrec:hfdlrec /var/lib/hfdl-recorder/%i
ExecStartPre=+/usr/bin/chown -R hfdlrec:hfdlrec /var/log/hfdl-recorder

# %i names the instance.  Per receiver it is the reporter key (AC0G-B1A):
# --instance %i reads /etc/hfdl-recorder/AC0G-B1A.toml, whose [instance]
# reporter_id names the squitter rows and whose one [[radiod]] block names
# that receiver's radiod; --radiod-id %i then matches no block and is
# ignored.  On a station not yet migrated, %i is a radiod status name, no
# per-instance file exists, and the daemon reads the legacy shared
# /etc/hfdl-recorder/hfdl-recorder-config.toml (with a DeprecationWarning),
# where --radiod-id %i picks that radiod's block.  --config is omitted on
# purpose: it would win over the per-instance file.
# (/var/lib/hfdl-recorder/%i above: an empty directory for a reporter key;
# the spool stays keyed by radiod.)
ExecStart=/opt/git/sigmond/hfdl-recorder/venv/bin/python3 -m hfdl_recorder.cli daemon \
    --instance %i \
    --radiod-id %i

TimeoutStartSec=60

Restart=always
RestartSec=5

# Logs go to the systemd journal (sigmond standard) — query with
# `journalctl -u hfdl-recorder@%i` or `smd log hfdl-recorder`.
StandardOutput=journal
StandardError=inherit
SyslogIdentifier=hfdl-recorder@%i

Nice=5
MemoryMax=2G
MemorySwapMax=0

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hfdl-recorder /var/log/hfdl-recorder
# The squitter timing batch writes sigmond's sink (/var/lib/sigmond/sink.db,
# root:sigmond 0664 in a 2775 dir; hfdlrec joins the sigmond group via
# install.sh) and hs-uploader's watermarks.  Without these paths every
# squitter timing insert fails "attempt to write a readonly database".
# (Decoded messages are no longer staged; squitter timing is why the
# sink path stays.)  Same as psk-recorder.
ReadWritePaths=-/var/lib/hs-uploader -/var/lib/sigmond
ReadOnlyPaths=/etc/hfdl-recorder /opt/git/sigmond/hfdl-recorder
PrivateNetwork=false

CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
