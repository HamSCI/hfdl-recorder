# hfdl-recorder configuration
# See https://github.com/HamSCI/hfdl-recorder for documentation.

[station]
# This station's identity: dumphfdl --station-id, and the station named in
# the local JSON and in the hfdl.spots rows.  Any unique string works (e.g.
# your callsign).  The airframes.io feed takes its own name, below
# (sinks.airframes_station_id), so leave this one alone when you turn it on.
station_id  = "YOURCALL-1"
grid_square = "AA00aa"

[paths]
dumphfdl  = "/opt/git/sigmond/hfdl-recorder/bin/dumphfdl"
spool_dir = "/var/lib/hfdl-recorder"
log_dir   = "/var/log/hfdl-recorder"
# dumphfdl reads + updates this systable as it learns ground-station IDs
# from squitters. Per-instance writable state.
systable  = "/var/lib/hfdl-recorder/systable.conf"

[sinks]
local_json   = true   # always write decoded JSON, one file per band
airframes_io = false  # opt-in: TCP push to feed.airframes.io:5556
# The station name you registered at https://app.airframes.io, exactly,
# capitals included.  airframes.io accepts the connection regardless but
# silently drops messages from an unregistered name.  Used only while
# airframes_io = true.  See README.md "Feeding airframes.io".
airframes_station_id = ""
# extra = [{ proto = "tcp", host = "agg.example", port = 5556, format = "json" }]

# Optional standalone fallback for chain-delay correction (contract v0.4 §8).
# Overridden by RADIOD_<id>_CHAIN_DELAY_NS in coordination.env when present.
# [timing]
# chain_delay_ns = 0

# Squitter timing windows.  Off by default.  When on, each enabled band keeps
# short labelled IQ windows (6 kS/s, about 120 kB each) around the chosen
# ground stations' squitters, for the batch timing analyser.  The windows stay
# on this station; dumphfdl decoding and the airframes.io feed run exactly as
# they do with this off.  Expect about 2 GB a day; saving stops (decoding
# does not) when free space falls below min_free_gb.
[timing_squitters]
enabled = false
# Names exactly as dumphfdl reports them (spdu.src.name).
ground_stations = ["Riverhead, New York", "San Francisco, California", "Molokai, Hawaii"]
# window_dir must stay under /var/lib/hfdl-recorder: the systemd units
# (ProtectSystem=strict) let the daemon and the batch analyser write there
# and nowhere else.  The batch reads this same key.
window_dir = "/var/lib/hfdl-recorder/squitters"
retention_days = 5
min_free_gb = 5

[[radiod]]
# REQUIRED: the mDNS control/status multicast name of the radiod to
# consume from.  Discover available radiods on the LAN with:
#   hfdl-recorder config init      (interactive wizard, picks one)
#   ka9q-python list               (raw discovery)
# Examples: "bee1-status.local", "rx888-status.local".  Leave the
# placeholder unchanged to make the daemon refuse to start until
# the operator runs the configurator.
status = "<configure-via-config-init>"

[radiod.bands]
# Curated default: high-yield bands across day/night propagation.
# Valid names match the radiod section names in 51-hfdl.conf:
#   HFDL2, HFDL3, HFDL4, HFDL5, HFDL6, HFDL8, HFDL10,
#   HFDL11, HFDL13, HFDL15, HFDL17, HFDL21
# HFDL15 is squitter-only (low yield); enable additional bands alongside it.
enabled = ["HFDL21", "HFDL13", "HFDL11", "HFDL10", "HFDL8", "HFDL6", "HFDL5"]
